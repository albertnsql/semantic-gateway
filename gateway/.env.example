# ============================================================
# AI Semantic Gateway — Environment Variables
# Copy this file to .env and fill in your real values.
# NEVER commit .env to source control.
# ============================================================

# --- Google Gemini ---
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-3.1-flash-lite
GOOGLE_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# --- OpenAI ---
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o
OPENAI_TEMPERATURE=0.0

# --- OpenRouter ---
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-3.1-flash-lite
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- Snowflake ---
SNOWFLAKE_ACCOUNT=your-account.snowflakecomputing.com
SNOWFLAKE_USER=your_snowflake_user
SNOWFLAKE_PASSWORD=your_snowflake_password
SNOWFLAKE_DATABASE=streaming_analytics
SNOWFLAKE_WAREHOUSE=compute_wh
SNOWFLAKE_ROLE=transformer
SNOWFLAKE_SCHEMA=marts

# --- dbt / MetricFlow Paths ---
MANIFEST_PATH=../dbt_streaming_analytics/streaming_analytics/target/manifest.json
METRICS_PATH=../dbt_streaming_analytics/streaming_analytics/metrics
SEMANTIC_MODELS_PATH=../dbt_streaming_analytics/streaming_analytics/models/semantic

# --- Gateway Runtime ---
GATEWAY_ENV=development
LOG_LEVEL=INFO

# --- Security ---
# API key for cost-bearing routes (/query, /dashboard). Required in production.
GATEWAY_API_KEY=
# Comma-separated allowed CORS origins. Restrict in production.
CORS_ALLOWED_ORIGINS=*


# Order the LLM provider chain is walked; the first entry is the primary.
# Default: google,groq,openrouter
#
# Set this to openrouter,google,groq on a host that cannot reach
# generativelanguage.googleapis.com. On Render the direct Gemini call returns
# NOTHING and times out at whatever ceiling is configured, while the same instance
# reaches openrouter.ai in ~400 ms — and OpenRouter serves the identical
# google/gemini-3.1-flash-lite, so it is a second route to the same model.
#
# Only worth inverting once OPENROUTER_API_KEY has credit: an unfunded OpenRouter
# returns 402 and simply adds a failed hop ahead of the others.
LLM_PROVIDER_ORDER=google,groq,openrouter

# Per-attempt LLM timeout in seconds (default 25). With no working fallback this
# IS the user's wait on a bad day, so it is deliberately not generous.
LLM_TIMEOUT_SECONDS=25
